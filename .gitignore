node_modules/
.wrangler/
.DS_Store
.claude/

# Production deploy config (custom domain route) — each deployment supplies its own.
tape-app/wrangler.prod.jsonc

# Measurement-rig bulk: fixtures, captures, and run outputs (gigabytes).
# The rig SCRIPTS are committed; their inputs/outputs are not.
#
# Spelled out rather than as a bare `testbed/media/`, because git does not
# descend into an excluded DIRECTORY and a negation inside one is therefore
# dead. fetch.sh only exists in the tree because it was force-added once, and
# the next fixture script would have been silently dropped the same way — which
# for a repo whose whole claim is reproducibility is the worst kind of quiet
# failure. Excluding the CONTENTS keeps the negation live.
testbed/media/*
!testbed/media/real/
testbed/media/real/*
!testbed/media/real/*.sh
testbed/runs/
testbed/out/
testbed/profiles/
testbed/*.png
phase1-transport/runs/
fatigue-lab/runs/
*.log

# Local dev secrets
tape-app/.dev.vars
tape-app/public/testmedia/
# Belt and braces. The real credentials live OUTSIDE this repo, in
# ~/.config/tokkah/cf.env (chmod 600) — a repo is source, not a keyring, and
# this project is AGPL-published, so a secret committed here is a secret
# published. These patterns exist so an accidental `.env` in the tree can never
# become a push.
.env
.env.*
*.env
!*.example.env
.dev.vars
.dev.vars.*

# Vendored third-party binaries (26 MB of MediaPipe wasm + face models).
# Same rule as testbed/media: the FETCH SCRIPT is committed, the binaries are
# not — a repo is source, not a CDN. tape-app/public/vendor/fetch.sh
# reproduces them byte-for-byte, and wrangler uploads them from the working
# tree at deploy time.
tape-app/public/vendor/

# Ad-hoc single-run rigs (dot-prefixed by convention). Durable rigs are
# committed undotted; these are scratch and would rot in the repo.
testbed/.*.mjs

# Real talking-head media staged into the peer image build context.
# Copies of testbed/media/real, ~96 MB -- fetched by media/real/fetch.sh, never committed.
testbed/peer/media/

# SwiftPM build output for the native macOS app. 339 MB across 2944 files --
# object files, the linked `tk` binary, dSYM archives, ModuleCache, the index
# store, and build.db -- every byte of it regenerated by `swift build`. It was
# tracked by accident, so each build re-dirtied `git status` with a couple of
# dozen paths and buried the actual Sources/ diff underneath them; on an
# AGPL-published repo it was also 339 MB that no reader can use, since a
# binary is not source. Untracked going forward rather than rewritten out of
# history: the old objects stay in the pack, but no new ones land.
mac/.build/
mac/tools/__pycache__/
