  "voiceover": [
    {
      "t": 0.3,
      "text": "Onefold. Worn shoes become new pairs."
    },
    {
      "t": 3.6,
      "text": "A road running shoe. Made from one material."
    },
    {
      "t": 7.1,
      "text": "Knit upper and sole. All the same material."
    },
    {
      "t": 11.1,
      "text": "For the miles you put in every day."
    },
    {
      "t": 15.1,
      "text": "And when you finally wear it out?"
    },
    {
      "t": 18.8,
      "text": "It doesn't belong in that drawer forever."
    },
    {
      "t": 22.5,
      "text": "Send it back instead."
    },
    {
      "t": 24.6,
      "text": "That same material becomes your next running shoe."
    },
    {
      "t": 28.6,
      "text": "Another pair, ready to head down the road."
    },
    {
      "t": 32.6,
      "text": "This pair's finish is the next pair's start."
    },
    {
      "t": 36.8,
      "text": "Less left behind. More miles to come."
    },
    {
      "t": 40.5,
      "text": "Run them. Return them."
    },
    {
      "t": 42.6,
      "text": "Onefold. Your next pair starts here."
    }
  ],
